APP_PORT=80

MYSQL_DATABASE=traditional_market
MYSQL_USER=market
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# HTTPS 배포에서는 true를 유지합니다. 로컬 HTTP 점검에서만 false로 변경하세요.
SESSION_COOKIE_SECURE=true
SWAGGER_ENABLED=false

# 최초 운영 관리자 생성 시 한 번만 true로 실행한 다음 false로 되돌립니다.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ADMIN_NAME=시장 관리자

# 토스 테스트 키와 카카오 JavaScript 키는 준비된 뒤 입력합니다.
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_API_BASE_URL=https://api.tosspayments.com
VITE_TOSS_PAYMENTS_CLIENT_KEY=
VITE_KAKAO_MAP_APP_KEY=

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Seoul
